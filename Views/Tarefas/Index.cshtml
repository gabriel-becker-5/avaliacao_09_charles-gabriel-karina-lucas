@model IEnumerable<Tarefa>

@{
    ViewData["Title"] = "Minhas Tarefas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Minhas Tarefas</h2>
    <a asp-action="Create" class="btn btn-success">+ Nova Tarefa</a>
</div>

<!-- Filtro por Status -->
<form asp-action="Index" method="get" class="row g-2 mb-4 align-items-center">
    <div class="col-auto">
        <select name="statusFiltro" class="form-select">
            <option value="">Todos os Status</option>
            <option value="Pendente">Pendente</option>
            <option value="Concluida">Concluída</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
</form>

<!-- Tabela de Tarefas -->
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>Data</th>
                <th>Status</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">Nenhuma tarefa encontrada.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Titulo</strong></td>
                        <td>@item.Data.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.Concluida)
                            {
                                <span class="badge bg-success">Concluída</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pendente</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white me-1">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>